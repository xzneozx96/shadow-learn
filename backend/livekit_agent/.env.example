# LiveKit configuration for ShadowLearn Voice Agent
# Copy this to .env and fill in your credentials

# Get these from LiveKit Cloud dashboard: https://cloud.livekit.io/projects/p_/settings/keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# OpenAI API key (for Observer LLM)
# Can also be provided per-session via user metadata
OPENAI_API_KEY=sk-your-openai-key

# Speechmatics API key (for user speech transcription)
# Can also be provided per-session via user metadata (speechmatics_key)
SPEECHMATICS_API_KEY=your-speechmatics-api-key

# Backend base URL. The agent fetches each speak session's Google key from
# {SHADOWLEARN_BACKEND_URL}/api/internal/speak-sessions/<id>/google-key with
# Authorization: Bearer <INTERNAL_TOKEN>. The shared fallback key lives on the
# backend as SHADOWLEARN_GOOGLE_API_KEY.
SHADOWLEARN_BACKEND_URL=http://localhost:8000

# Azure Speech (optional, for pronunciation assessment)
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=eastus

# Offshore FastAPI proxy
# Shared secret with the China-side backend. Generate once:
#   python -c "import uuid; print(uuid.uuid4().hex)"
# China backend stores the same value as SHADOWLEARN_OFFSHORE_INTERNAL_TOKEN.
INTERNAL_TOKEN=
HTTP_PORT=8082
