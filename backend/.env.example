# ShadowLearn Backend Environment Variables
# Copy this file to .env and fill in the values.

# ── TTS Provider ──────────────────────────────────────────────────────────────
# Which TTS provider to use. Default: azure
# Values: azure | minimax
SHADOWLEARN_TTS_PROVIDER=azure

# ── Model / API URLs (optional overrides) ────────────────────────────────────
# Default: https://openrouter.ai/api/v1/chat/completions
# SHADOWLEARN_OPENROUTER_CHAT_URL=

# Default: qwen/qwen3.5-122b-a10b
# SHADOWLEARN_OPENROUTER_MODEL=

# Default: https://api.minimax.io/v1/t2a_v2
# SHADOWLEARN_MINIMAX_TTS_URL=

# ── Limits (optional overrides) ───────────────────────────────────────────────
# Max video duration in seconds. Default: 1200 (20 minutes)
# SHADOWLEARN_MAX_VIDEO_DURATION_SECONDS=

# Max upload size in bytes. Default: 2147483648 (2 GB)
# SHADOWLEARN_MAX_UPLOAD_SIZE_BYTES=

# Allowed video formats. Default: mp4,mkv,webm,mov
# SHADOWLEARN_ALLOWED_VIDEO_FORMATS=

# Translation batch size. Default: 30
# SHADOWLEARN_TRANSLATION_BATCH_SIZE=

# Translation max retries. Default: 2
# SHADOWLEARN_TRANSLATION_MAX_RETRIES=

# ── LiveKit Configuration (for Speak with AI voice agent) ─────────────────────
# Get these from your LiveKit Cloud project dashboard
# SHADOWLEARN_LIVEKIT_URL=wss://your-project.livekit.cloud
# SHADOWLEARN_LIVEKIT_API_KEY=APxxxxxxxx
# SHADOWLEARN_LIVEKIT_API_SECRET=xxxxxxxx

# ── Provider keys ────────────────────────────────────────────────────────────
# Required. Encrypts the provider keys accounts save in Settings. Startup fails
# when it is missing or not a Fernet key. Changing it makes every saved key
# unreadable, and each account must save its key again. Generate one with
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
SHADOWLEARN_ENCRYPTION_KEY=
# Shared fallback keys, used when an account has not saved its own key.
# /api/config reports which ones are set under shared_keys.
# SHADOWLEARN_OPENROUTER_API_KEY=
# SHADOWLEARN_AZURE_SPEECH_KEY=
# SHADOWLEARN_AZURE_SPEECH_REGION=
# SHADOWLEARN_GOOGLE_API_KEY=
# Server-only keys. Accounts cannot save these.
# SHADOWLEARN_DEEPGRAM_API_KEY=
# SHADOWLEARN_MINIMAX_API_KEY=
# Requests per minute per account on the provider-backed endpoints. Default: 60
# SHADOWLEARN_RATE_LIMIT_PER_MINUTE=

# ── Offshore Gemini Proxy ────────────────────────────────────────────────────
# Backend forwards Gemini-bound traffic (situation generation) to the
# offshore livekit_agent FastAPI so the GFW does not block the call.
# Token is the shared secret with backend/livekit_agent/.env INTERNAL_TOKEN.
# SHADOWLEARN_OFFSHORE_BASE_URL=http://livekit-agent:8082
# SHADOWLEARN_OFFSHORE_INTERNAL_TOKEN=

# ── YouTube Download (optional) ───────────────────────────────────────────────
# Path to Netscape cookies.txt exported from Firefox while signed into a
# throwaway YouTube account. Needed on VPS/datacenter IPs to bypass bot detection.
# Export: yt-dlp --cookies-from-browser firefox --cookies youtube_cookies.txt <url> --skip-download
# SHADOWLEARN_YTDLP_COOKIES_FILE=./youtube_cookies.txt

# ── Collection — YouTube Data API ────────────────────────────────────────────
# Required for the /collection page. Get a key from Google Cloud Console:
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
# Free quota: 10,000 units/day (8 curated playlists ≈ 32 units/day).
# SHADOWLEARN_YOUTUBE_API_KEY=AIza...

# ── agentic-rag retrieval backend ─────────────────────────────────────────────
# The AI Companion proxies its RAG tools (/api/pageindex/tool) to the agentic-rag
# service. Point this at agentic-rag's OWN URL/port — NOT this backend's port.
# In dev, agentic-rag runs on 8010 (this backend is 8000).
# SHADOWLEARN_AGENTIC_RAG_BASE_URL=http://localhost:8010
# Shared secret to authenticate to agentic-rag as the external full-access
# consumer — must equal agentic-rag's API_SECRET_KEY. Server-side only.
# SHADOWLEARN_AGENTIC_RAG_API_KEY=

# ── Postgres and MinIO ───────────────────────────────────────────────────────
# Defaults match `docker compose up -d postgres minio` on 127.0.0.1:5435 and
# 127.0.0.1:9005. Change those host ports with SHADOWLEARN_PG_HOST_PORT and
# SHADOWLEARN_MINIO_HOST_PORT in the shell or a root .env. Inside compose the
# backend service overrides these to reach the `postgres` and `minio`
# containers. The compose file reads POSTGRES_PASSWORD, MINIO_ROOT_USER, and
# MINIO_ROOT_PASSWORD from the shell or a root .env, so set those there in
# production, not here.
# SHADOWLEARN_DATABASE_URL=postgresql+asyncpg://shadowlearn:shadowlearn@127.0.0.1:5435/shadowlearn
# SHADOWLEARN_S3_ENDPOINT=http://127.0.0.1:9005
# SHADOWLEARN_S3_ACCESS_KEY=shadowlearn
# SHADOWLEARN_S3_SECRET_KEY=shadowlearn
# SHADOWLEARN_S3_BUCKET=shadowlearn
# SHADOWLEARN_S3_REGION=us-east-1
# Scratch directory for downloads and media processing.
# SHADOWLEARN_TEMP_DIR=/tmp/shadowlearn
# Test database for pytest. The fixture creates it when missing and migrates it.
# SHADOWLEARN_TEST_DATABASE_URL=postgresql+asyncpg://shadowlearn:shadowlearn@127.0.0.1:5435/shadowlearn_test

# ── Accounts ─────────────────────────────────────────────────────────────────
# Required. Startup fails when either secret is missing or shorter than 32
# characters. Generate each with `openssl rand -hex 32` and never reuse one.
SHADOWLEARN_JWT_SECRET=
SHADOWLEARN_JWT_REFRESH_SECRET=
# SHADOWLEARN_ACCESS_TOKEN_MINUTES=15
# SHADOWLEARN_REFRESH_TOKEN_DAYS=30
# Base URL of the frontend, used to build the password reset link.
# SHADOWLEARN_PUBLIC_APP_URL=http://localhost:5173
# CORS. Exact origins, as a JSON array. Production must list its frontend origin.
# SHADOWLEARN_FRONTEND_ORIGIN_ALLOWLIST='["http://localhost:5173","http://127.0.0.1:5173"]'
# Optional regex for origins such as Vercel previews. It also admits every other
# site that matches, so set it per environment.
# SHADOWLEARN_FRONTEND_ORIGIN_REGEX=https://.*\.vercel\.app

# ── Password reset email ─────────────────────────────────────────────────────
# With SMTP_HOST empty, the backend logs the reset link at INFO instead of sending.
# That fallback is for local dev only: startup fails when SMTP_HOST is empty and
# PUBLIC_APP_URL is not a localhost or 127.0.0.1 URL.
# SMTP_SECURITY is none, starttls, or ssl. Use ssl for an implicit TLS relay on 465.
# SHADOWLEARN_SMTP_HOST=
# SHADOWLEARN_SMTP_PORT=587
# SHADOWLEARN_SMTP_SECURITY=starttls
# SHADOWLEARN_SMTP_USER=
# SHADOWLEARN_SMTP_PASSWORD=
# SHADOWLEARN_SMTP_FROM=ShadowLearn <no-reply@example.com>
